{
  "system2_rules": {
    "global": {
      "files": [
        "global/code-standards.md",
        "global/dev-convention.md",
        "global/documentation.md",
        "global/testing.md",
        "global/tool-use.md"
      ]
    },
    "main": {
      "files": [
        "main/communication.md",
        "main/tool-use.md",
        "main/workers.md",
        "main/issues.md"
      ]
    },
    "worker": {
      "files": [
        "worker/worker-rules.md"
      ]
    },
    "projects": {},
    "exclude_projects": []
  },
  "tool_injection": {
    "exclude_projects": []
  },
  "model_params": {
    "claude-fable-5": {"thinking": {"type": "adaptive", "display": "summarized"}, "effort": "medium", "max_tokens": 64000},
    "claude-fable-5-1": {"thinking": {"type": "adaptive", "display": "summarized"}, "effort": "medium", "max_tokens": 32000},
    "claude-opus-5": {"thinking": {"type": "adaptive", "display": "summarized"}, "effort": "medium", "max_tokens": 32000},
    "claude-sonnet-5": {"thinking": {"type": "adaptive", "display": "summarized"}, "effort": "high", "max_tokens": 64000},
    "claude-opus-5-5": {"thinking": {"type": "adaptive", "display": "summarized"}, "effort": "medium", "max_tokens": 64000}
  },
  "pyright_diagnostics_strip": {
    "enabled": true
  },
  "context_management": {
    "enabled": false,
    "clear_tool_uses": {
      "enabled": true,
      "trigger_input_tokens": 100000,
      "keep_tool_uses": 5,
      "clear_at_least_tokens": 10000
    },
    "clear_thinking": {
      "enabled": false,
      "keep_thinking_turns": 2
    }
  }
}
