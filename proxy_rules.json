{
  "system2_rules": {
    "global": {
      "files": [
        "global/communication.md",
        "global/documentation.md",
        "global/tool-use.md"
      ]
    },
    "opus": {
      "files": [
        "opus/chat-output.md",
        "opus/gh-issues.md",
        "opus/workers-1.md",
        "opus/workers-2.md",
        "opus/workers-3.md"
      ]
    },
    "worker": {
      "files": [
        "worker/code-organization.md",
        "worker/code-standards.md",
        "worker/dev-convention.md",
        "worker/verification.md",
        "worker/worker-rules.md"
      ]
    },
    "exclude_projects": [
      "wise2627"
    ]
  },
  "tool_injection": {
    "exclude_projects": [
      "wise2627"
    ]
  },
  "model_override": {
    "enabled": true,
    "model": "claude-opus-4-8",
    "thinking": {
      "type": "adaptive",
      "display": "omitted"
    },
    "effort": "xhigh",
    "max_tokens": 128000
  },
  "model_override_worker": {
    "enabled": true,
    "model": "claude-sonnet-4-6",
    "thinking": {"type": "adaptive", "display": "omitted"},
    "effort": "high",
    "max_tokens": 64000
  },
  "pyright_diagnostics_strip": {
    "enabled": true
  },
  "context_management": {
    "enabled": false,
    "clear_tool_uses": {
      "enabled": true,
      "trigger_input_tokens": 100000,
      "keep_tool_uses": 5,
      "clear_at_least_tokens": 10000
    },
    "clear_thinking": {
      "enabled": false,
      "keep_thinking_turns": 2
    }
  }
}
